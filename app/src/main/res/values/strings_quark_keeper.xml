<?xml version="1.0" encoding="utf-8"?>
<!--
  Quark Keeper notification resources.

  Kept in its own file rather than appended to strings.xml so a change to the guard's wording cannot
  collide with an edit to the app-wide catalogue. Only the names the notification layer alone owns are
  declared here: the alert, countdown and button labels are shared with the in-app surfaces and stay
  in strings.xml alongside the rest of the guard's copy.
-->
<resources>
    <string name="channel_quark_keeper_reminder">Check-in reminder</string>
    <string name="quark_keeper_daily_reminder_title">Time to check in on Quark</string>
    <string name="quark_keeper_daily_reminder_message">The daily check-in is still open, and a few seconds is all it takes.</string>
    <!--
      The duration phrase interpolated into quark_keeper_ongoing_message and quark_keeper_alert_message.
      Both are only ever handed whole hours, so the sub-hour case needs its own wording: "0 h left"
      would read as "too late" during the final hour, when the user can still check in.
    -->
    <string name="quark_keeper_remaining_hours">%1$d h</string>
    <string name="quark_keeper_remaining_less_than_hour">less than an hour</string>

    <!-- Quark Keeper: keeps a daily Quark check-in streak from breaking. -->
